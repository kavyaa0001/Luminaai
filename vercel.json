{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "public" }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/hello.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
