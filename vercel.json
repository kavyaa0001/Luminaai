{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/api-server/src/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "artifacts/video-learning/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "artifacts/api-server/src/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "artifacts/video-learning/$1",
      "continue": true
    },
    {
      "source": "/(.*)",
      "destination": "artifacts/video-learning/index.html"
    }
  ]
}
